# SREE Assistant Environment Configuration
APP_NAME=SREE
APP_ENV=development
HOST=0.0.0.0
PORT=8005

# Active AI Brain Provider: ollama (default offline), groq, gemini, openrouter, openai, custom
AI_PROVIDER=ollama

# Local AI Engine (Ollama - 100% Offline GPU)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2:3b
FALLBACK_MODEL=llama3.2:1b

# Optional Cloud AI Providers (Multi-Provider AI Routing)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CUSTOM_OPENAI_BASE_URL=http://localhost:1234/v1
CUSTOM_OPENAI_API_KEY=not-needed
CUSTOM_MODEL=default

# Security (Set strong token for production/mobile access)
AUTH_TOKEN=sree-local-secure-key-2026
ALLOW_LAN_ACCESS=true

# Storage
DATABASE_PATH=data/database/sree.db
